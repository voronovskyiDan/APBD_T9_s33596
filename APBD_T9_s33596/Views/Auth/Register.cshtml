@using APBD_T9_s33596.ViewModels
@model RegisterViewModel
@{
    ViewData["Title"] = "Register";
}

<div class="card">
    <div class="card-body">
        <h2>Create Account</h2>

        <form asp-action="Register" method="post">
            <div asp-validation-summary="All" class="validation-summary"></div>

            <div class="form-group">
                <label asp-for="Email">Email</label>
                <input asp-for="Email" type="email" autocomplete="email" />
                <span asp-validation-for="Email" class="field-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password">Password</label>
                <input asp-for="Password" type="password" autocomplete="new-password" />
                <span asp-validation-for="Password" class="field-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="ConfirmPassword">Confirm Password</label>
                <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="field-error"></span>
            </div>

            <button type="submit" class="btn btn-primary">Register</button>
            <p class="form-hint">Already have an account? <a asp-action="Login">Log in</a></p>
        </form>
    </div>
</div>
