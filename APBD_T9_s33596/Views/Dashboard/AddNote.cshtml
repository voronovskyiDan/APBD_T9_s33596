@using APBD_T9_s33596.ViewModels
@model AddNoteViewModel
@{
    ViewData["Title"] = "Add Note";
}

<div class="card">
    <div class="card-body">
        <h2>New Note</h2>

        <form asp-action="AddNote" method="post">
            <div asp-validation-summary="All" class="validation-summary"></div>

            <div class="form-group">
                <label asp-for="Title">Title</label>
                <input asp-for="Title" />
                <span asp-validation-for="Title" class="field-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Content">Content</label>
                <textarea asp-for="Content" rows="5"></textarea>
                <span asp-validation-for="Content" class="field-error"></span>
            </div>

            <div class="btn-row">
                <button type="submit" class="btn btn-primary">Save Note</button>
                <a asp-action="Index" class="btn btn-warning">Cancel</a>
            </div>
        </form>
    </div>
</div>
